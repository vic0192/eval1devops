{
  "name": "integrador-cicd-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de usuarios para el proyecto integrador de CI/CD.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage --runInBand"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.1.3"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/app.js",
      "src/error-handler.js",
      "src/messages.js",
      "src/users.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
